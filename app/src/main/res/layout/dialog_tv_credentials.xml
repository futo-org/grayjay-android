<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_credentials_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/tv_credentials_select"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_credentials_all"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:fontFamily="@font/inter_medium"
            android:letterSpacing="0"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/tv_credentials_all"
            android:textAllCaps="false"
            android:textColor="#019BE7"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_credentials_destination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/inter_regular"
        android:textColor="@color/gray_ac"
        android:textSize="14sp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/tv_credentials_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/tv_credentials_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#303030" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_credentials_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_medium"
            android:letterSpacing="0"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/gray_ac" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_credentials_continue"
            style="@style/TvInstallPrimary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:letterSpacing="0"
            android:text="@string/tv_install_continue"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
