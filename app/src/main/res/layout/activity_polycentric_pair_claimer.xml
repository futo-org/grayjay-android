<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageButton
        android:id="@+id/button_back"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:contentDescription="@string/cd_button_back"
        android:padding="10dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/ic_back_thin_white_16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <TextView
        android:id="@+id/text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/pairing_pair_with_existing_device"
        android:fontFamily="@font/inter_regular"
        android:textSize="18dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="@id/button_back"
        app:layout_constraintBottom_toBottomOf="@id/button_back"
        app:layout_constraintLeft_toRightOf="@id/button_back"
        app:layout_constraintRight_toRightOf="parent" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/button_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- Entry: scan or paste a pairing link -->
        <ScrollView
            android:id="@+id/layout_entry"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/pairing_entry_instructions"
                    android:textColor="@color/gray_ac"
                    android:fontFamily="@font/inter_light"
                    android:textSize="14dp" />

                <LinearLayout
                    android:id="@+id/button_scan_qr"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:background="@drawable/background_border_2e_round_6dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/ic_qr" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pairing_scan_qr_code"
                        android:lines="1"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="16dp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/edit_link"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="16dp"
                    android:padding="16dp"
                    android:background="@drawable/background_1b_round_6dp"
                    android:fontFamily="monospace"
                    android:textSize="12dp"
                    android:gravity="start|top"
                    android:inputType="textUri|textMultiLine|textNoSuggestions"
                    android:maxLines="20"
                    android:hint="@string/pairing_paste_link" />

                <TextView
                    android:id="@+id/button_continue"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/background_019be7_round_6dp"
                    android:gravity="center"
                    android:text="@string/pairing_continue"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="16dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Loading: fetching, joining, or claiming -->
        <LinearLayout
            android:id="@+id/layout_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.futo.platformplayer.views.LoaderView
                android:layout_width="32dp"
                android:layout_height="32dp" />

            <TextView
                android:id="@+id/text_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter_regular"
                android:textSize="16dp"
                tools:text="@string/pairing_loading_session" />
        </LinearLayout>

        <!-- Confirm: "Is this you?" -->
        <LinearLayout
            android:id="@+id/layout_confirm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pairing_is_this_you"
                android:fontFamily="@font/inter_regular"
                android:textSize="22dp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image_issuer_avatar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="24dp"
                android:scaleType="centerCrop"
                android:background="@drawable/video_thumbnail_outline"
                app:shapeAppearanceOverlay="@style/roundedCorners_40dp"
                app:srcCompat="@drawable/placeholder_profile" />

            <TextView
                android:id="@+id/text_issuer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_semibold"
                android:textSize="18dp"
                tools:text="Name" />

            <TextView
                android:id="@+id/text_issuer_identity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textSize="11dp"
                android:textColor="@color/gray_ac"
                android:textAlignment="center"
                android:textIsSelectable="true"
                tools:text="9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/button_confirm_cancel"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/background_border_2e_round_6dp"
                    android:gravity="center"
                    android:text="@string/cancel"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="16dp" />

                <TextView
                    android:id="@+id/button_confirm_pair"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/background_019be7_round_6dp"
                    android:gravity="center"
                    android:text="@string/pairing_pair"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="16dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Waiting: show our fingerprint until the issuer approves -->
        <LinearLayout
            android:id="@+id/layout_waiting"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/background_solid_border_2e_round_6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pairing_your_matching_code"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="18dp" />

                <com.futo.platformplayer.views.others.HarborEmojiFingerprintView
                    android:id="@+id/fingerprint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:emojiSize="56dp" />

                <TextView
                    android:id="@+id/text_claimer_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="monospace"
                    android:textSize="11dp"
                    android:textColor="@color/gray_ac"
                    android:textAlignment="center"
                    android:textIsSelectable="true"
                    tools:text="1_9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.futo.platformplayer.views.LoaderView
                        android:layout_width="16dp"
                        android:layout_height="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/pairing_waiting_for_approval"
                        android:textColor="@color/gray_ac"
                        android:fontFamily="@font/inter_light"
                        android:textSize="12dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_waiting_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter_light"
                    android:textAlignment="center"
                    android:textColor="@color/pastel_red"
                    android:textSize="12dp"
                    android:visibility="gone"
                    tools:text="Couldn't check for approval. Retrying…"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/text_waiting_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/gray_ac"
                    android:textSize="13dp"
                    tools:text="Valid for 04:59" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/pairing_check_other_device"
                android:fontFamily="@font/inter_regular"
                android:textSize="14dp" />
        </LinearLayout>

        <!-- Result: success, error, or expired -->
        <LinearLayout
            android:id="@+id/layout_result"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:padding="24dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/background_solid_border_2e_round_6dp">

                <ImageView
                    android:id="@+id/image_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_pair_fail" />

                <TextView
                    android:id="@+id/text_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAlignment="center"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="20dp"
                    tools:text="@string/pairing_failed" />

                <TextView
                    android:id="@+id/text_result_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:maxHeight="200dp"
                    android:scrollbars="vertical"
                    android:textAlignment="center"
                    android:textColor="#8C8C8C"
                    android:fontFamily="@font/inter_light"
                    android:textSize="12dp"
                    tools:text="An error has occurred" />

                <TextView
                    android:id="@+id/button_result"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/background_019be7_round_6dp"
                    android:gravity="center"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="16dp"
                    tools:text="@string/pairing_go_back" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
