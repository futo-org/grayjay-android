<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/background_1b_round_6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/tv_install_device_open"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_live_tv" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_install_device_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_install_device_address"
                style="@style/TvInstallDescription"
                android:layout_marginTop="4dp"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_install_device_status"
                style="@style/TvInstallDescription"
                android:layout_marginTop="6dp"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/tv_install_device_more"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="14dp"
        app:srcCompat="@drawable/ic_more" />
</LinearLayout>
