<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageButton
        android:id="@+id/button_back"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:contentDescription="@string/cd_button_back"
        android:padding="10dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/ic_back_thin_white_16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <TextView
        android:id="@+id/text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/pairing_pair_a_device"
        android:fontFamily="@font/inter_regular"
        android:textSize="18dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="@id/button_back"
        app:layout_constraintBottom_toBottomOf="@id/button_back"
        app:layout_constraintLeft_toRightOf="@id/button_back"
        app:layout_constraintRight_toRightOf="parent" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/button_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- Loading: creating the session -->
        <LinearLayout
            android:id="@+id/layout_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <com.futo.platformplayer.views.LoaderView
                android:layout_width="32dp"
                android:layout_height="32dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/pairing_creating_session"
                android:fontFamily="@font/inter_regular"
                android:textSize="16dp" />
        </LinearLayout>

        <!-- Session: the pairing link as a QR code -->
        <ScrollView
            android:id="@+id/layout_session"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/pairing_issuer_instructions"
                    android:textColor="@color/gray_ac"
                    android:fontFamily="@font/inter_light"
                    android:textSize="14dp" />

                <ImageView
                    android:id="@+id/image_qr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/pairing_pair_a_device"
                    app:srcCompat="@drawable/ic_qr" />

                <LinearLayout
                    android:id="@+id/button_copy"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:background="@drawable/background_border_2e_round_6dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/ic_copy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pairing_copy_link"
                        android:lines="1"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="16dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/button_share"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:background="@drawable/background_border_2e_round_6dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/ic_share" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/share"
                        android:lines="1"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="16dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/gray_ac"
                    android:textSize="13dp"
                    tools:text="Valid for 04:59" />

                <TextView
                    android:id="@+id/text_poll_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter_light"
                    android:textAlignment="center"
                    android:textColor="@color/pastel_red"
                    android:textSize="12dp"
                    android:visibility="gone"
                    tools:text="Couldn't check for devices. Retrying…"
                    tools:visibility="visible" />
            </LinearLayout>
        </ScrollView>

        <!-- Approval: a device asked to join -->
        <ScrollView
            android:id="@+id/layout_approval"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/pairing_pending_approval"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pairing_pending_approval_description"
                    android:textAlignment="center"
                    android:textColor="@color/gray_ac"
                    android:fontFamily="@font/inter_light"
                    android:textSize="14dp" />

                <com.futo.platformplayer.views.others.HarborEmojiFingerprintView
                    android:id="@+id/fingerprint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:emojiSize="56dp" />

                <TextView
                    android:id="@+id/text_claimer_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="monospace"
                    android:textSize="11dp"
                    android:textColor="@color/gray_ac"
                    android:textAlignment="center"
                    android:textIsSelectable="true"
                    tools:text="1_9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08" />

                <LinearLayout
                    android:id="@+id/layout_rotation_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/background_border_2e_round_6dp">

                    <com.futo.platformplayer.views.others.Checkbox
                        android:id="@+id/checkbox_rotation_key"
                        android:layout_width="24dp"
                        android:layout_height="24dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pairing_add_as_rotation_key"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="14dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pairing_add_as_rotation_key_description"
                            android:textColor="@color/gray_ac"
                            android:fontFamily="@font/inter_light"
                            android:textSize="12dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_approval_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/button_deny"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/background_border_2e_round_6dp"
                        android:gravity="center"
                        android:text="@string/pairing_deny"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="16dp" />

                    <TextView
                        android:id="@+id/button_approve"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/background_019be7_round_6dp"
                        android:gravity="center"
                        android:text="@string/pairing_approve"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="16dp" />
                </LinearLayout>

                <com.futo.platformplayer.views.LoaderView
                    android:id="@+id/loader_approving"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="24dp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- Result: success, error, or expired -->
        <LinearLayout
            android:id="@+id/layout_result"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:padding="24dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/background_solid_border_2e_round_6dp">

                <ImageView
                    android:id="@+id/image_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_pair_success" />

                <TextView
                    android:id="@+id/text_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAlignment="center"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="20dp"
                    tools:text="@string/pairing_issuer_success" />

                <TextView
                    android:id="@+id/text_result_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:maxHeight="200dp"
                    android:scrollbars="vertical"
                    android:textAlignment="center"
                    android:textColor="#8C8C8C"
                    android:fontFamily="@font/inter_light"
                    android:textSize="12dp"
                    tools:text="@string/pairing_issuer_success_details" />

                <TextView
                    android:id="@+id/button_done"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/background_019be7_round_6dp"
                    android:gravity="center"
                    android:text="@string/done"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="16dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
