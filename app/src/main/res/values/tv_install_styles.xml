<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TvInstallTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">28sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TvInstallDescription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/gray_ac</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:lineSpacingExtra">5dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="TvInstallLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/gray_e0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">22dp</item>
    </style>
    <style name="TvInstallInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/background_solid_border_2e_round_6dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/gray_8c</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext|flagNoPersonalizedLearning</item>
    </style>
    <style name="TvInstallType" parent="TvInstallPrimary">
        <item name="android:layout_height">72dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="backgroundTint">#1B1B1B</item>
        <item name="strokeColor">#303030</item>
        <item name="strokeWidth">1dp</item>
        <item name="icon">@drawable/ic_arrow_right</item>
        <item name="iconGravity">end</item>
        <item name="iconTint">@color/gray_ac</item>
        <item name="iconSize">20dp</item>
    </style>
    <style name="TvInstallPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">#019BE7</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>
