<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TvCredentialsDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">#019BE7</item>
        <item name="colorSecondary">#019BE7</item>
        <item name="colorSurface">#1B1B1B</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:windowBackground">@drawable/background_1b_round_6dp</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/gray_ac</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="buttonBarPositiveButtonStyle">@style/TvCredentialsDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/TvCredentialsDialogButton</item>
    </style>
    <style name="TvCredentialsDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>
    <style name="TvCredentialsSheet" parent="Custom.BottomSheetDialog.Theme">
        <item name="bottomSheetStyle">@style/TvCredentialsSheetPanel</item>
        <item name="colorPrimary">#019BE7</item>
        <item name="colorSecondary">#019BE7</item>
        <item name="colorOnSurface">@color/white</item>
    </style>
    <style name="TvCredentialsSheetPanel" parent="Custom.BottomSheet.Modal.Style">
        <item name="backgroundTint">#1B1B1B</item>
    </style>
</resources>
